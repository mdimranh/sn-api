PORT=4000
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/notes?retryWrites=true&w=majority
# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=1d
# Comma separated list of allowed frontend origins ("*" allows all)
CORS_ORIGIN=http://localhost:3000
# Optional: an admin account is created on boot if it doesn't exist
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
